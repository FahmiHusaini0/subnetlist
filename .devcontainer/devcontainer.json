{
  "name": "subnetlist",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "remoteUser": "node",
  "containerUser": "node",
  "updateRemoteUserUID": true,
  "runArgs": ["--init"],
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js app",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
